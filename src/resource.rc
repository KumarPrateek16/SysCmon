#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "..\\assets\\SysCmon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "kumarprateek16"
            VALUE "FileDescription",  "SysCmon - Local System Performance Monitor"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "SysCmon"
            VALUE "OriginalFilename", "SysCmon.exe"
            VALUE "ProductName",      "SysCmon System Suite"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
